[Unit]
Description=BTC 1000X forward shadow pass (DRY_RUN, no orders)

[Service]
Type=oneshot
WorkingDirectory=/root/btc1000x
Environment=B1K_ROOT=/root/btc1000x
ExecStart=/usr/bin/flock -n /root/btc1000x/state/shadow.lock /usr/bin/timeout 600 /usr/bin/nice -n 10 /root/btc1000x/.venv/bin/python -m b1k.execution.shadow run
Nice=10
